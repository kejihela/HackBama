# Leave RESEND_API_KEY empty to run in demo mode (login codes are shown on screen).
RESEND_API_KEY=
EMAIL_FROM="CampusLoop <login@yourdomain.com>"
# Key required on /admin to launch a new campus.
ADMIN_KEY=hackbama
# Root domain for subdomain routing in production, e.g. campusloop.app
ROOT_DOMAIN=localhost

# --- AI moderation ---
# Set an OpenAI or Claude key to turn on the LLM safety screen for chat and listings.
# Without one, CampusLoop uses the built-in keyword rules only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# openai | anthropic (default: whichever key is set, OpenAI first)
MODERATION_PROVIDER=
# Optional: model and timeout (defaults: gpt-5.4-mini for OpenAI, claude-opus-5-5 for Claude).
MODERATION_MODEL=
MODERATION_TIMEOUT_MS=4000
# Set to "off" to force rules-only even when a key is present.
AI_MODERATION=
